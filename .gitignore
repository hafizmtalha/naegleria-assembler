# Build output
target/
*.so
*.pyd
__pycache__/
*.egg-info/
.pytest_cache/
dist/
build/

# Pipeline output. The leading slash matters: "data/" with no slash matches any
# directory called data at any depth, which quietly swallowed tests/data and its
# BUSCO fixtures, so eight tests passed here and failed on a fresh clone.
/data/
/results/
logs/
.snakemake/

# BUSCO downloads its lineages into here when no --busco-download-path is given
busco_downloads/
completeness/
